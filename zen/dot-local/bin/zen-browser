#!/bin/bash

# Keep leading browser options out of the forwarded section
options=()
while (($#)) && [[ $1 == -* ]]; do
  options+=("$1")
  shift
done

exec /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=launch-script.sh \
  --file-forwarding app.zen_browser.zen "${options[@]}" @@u "$@" @@
