{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "permission": {
    "external_directory": {
      "$HOME/.config/**": "allow",
      "$HOME/.local/share/**": "allow",
      "$HOME/.local/state/**": "allow",
      "/etc/**": "allow",
      "/usr/share/**": "allow"
    },
    "edit": {
      "$HOME/.config/**": "deny",
      "$HOME/.local/share/**": "deny",
      "$HOME/.local/state/**": "deny",
      "/etc/**": "deny",
      "/usr/share/**": "deny"
    }
  }
}
