[Unit]
BindsTo=supergfxd.service
After=supergfxd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl stop display-manager.service
ExecStart=/usr/bin/supergfxctl --mode Integrated
ExecStart=/usr/bin/timeout 10 /bin/bash -c 'until [[ "$(/usr/bin/supergfxctl --get)" == "Integrated" ]]; do sleep 1; done'
ExecStart=/usr/bin/systemctl start display-manager.service
