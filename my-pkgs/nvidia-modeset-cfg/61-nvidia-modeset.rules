# The NVIDIA Vulkan driver needs /dev/nvidia-modeset to present frames. On the
# host it creates the node on demand through the setuid nvidia-modprobe helper,
# but setuid helpers don't work inside containers (Steam's pressure-vessel,
# Flatpak). There, presentation fails with VK_ERROR_UNKNOWN and games never
# show a window, until some host program happens to create the node.
# 60-nvidia.rules from nvidia-utils creates the other nodes when nvidia_drm
# loads, but not this one.
ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia_drm", TEST!="/dev/nvidia-modeset", \
    RUN+="/usr/bin/nvidia-modprobe -m"
