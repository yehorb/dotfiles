{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-6-sol",
  "agents": {
    "build": {
      "model": "openai/gpt-6-sol#medium"
    },
    "plan": {
      "model": "openai/gpt-6-sol#medium"
    },
    "general": {
      "model": "openai/gpt-6-sol#medium"
    },
    "explore": {
      "model": "openai/gpt-6-luna#high"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "$HOME/.config/**", "effect": "allow" },
    { "action": "external_directory", "resource": "$HOME/.local/share/**", "effect": "allow" },
    { "action": "external_directory", "resource": "$HOME/.local/state/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/share/**", "effect": "allow" },
    { "action": "edit", "resource": "$HOME/.config/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.local/share/**", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.local/state/**", "effect": "deny" },
    { "action": "edit", "resource": "/etc/**", "effect": "deny" },
    { "action": "edit", "resource": "/usr/share/**", "effect": "deny" }
  ]
}
