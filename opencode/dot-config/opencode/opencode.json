{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "external_directory": {
      "$HOME/.config/**": "allow",
      "$HOME/.local/share/omarchy/**": "allow",
      "/etc/**": "allow",
      "/usr/share/**": "allow"
    },
    "edit": {
      "$HOME/.config/**": "deny",
      "$HOME/.local/share/omarchy/**": "deny",
      "/etc/**": "deny",
      "/usr/share/**": "deny"
    }
  }
}
