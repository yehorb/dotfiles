restow_shell() {
  for d in bash/ git/ home-manager/ nvim/ starship/ stow/ tmux/; do
    if [[ -d $d ]]; then
      echo "Restow $d"
      stow -D $d && stow -S $d
    else
      echo "[Error]: no such directory: $d ($PWD/$d)"
    fi
  done
}

format_shell_scripts() {
  # Find all files that either don't have an extension of have .sh/.bash extension; excluding .git dir; and apply shfmt
  # Regex: no dots after the last / with optional .sh/.bash extension
  # Requires some manual cleanup (discarding changes) in some LICENSE and config files
  find "$PWD" \( -regextype sed -regex ".*/[^\.]\+\(\.sh\|\.bash\)\?$" -o -path "*.git*" -prune \) -type f -exec shfmt -i 2 -w {} +
}

