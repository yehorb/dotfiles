# Apply the setting now instead of at the next boot, and turn boost back on
# when the package is removed. Skip when systemd isn't running, e.g. when
# installing into a chroot.
BOOST=/sys/devices/system/cpu/cpufreq/boost

post_install() {
    [ -d /run/systemd/system ] || return 0
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/50-cpu-boost-off.conf
}

post_upgrade() {
    post_install
}

post_remove() {
    [ -d /run/systemd/system ] && [ -w "$BOOST" ] || return 0
    echo 1 > "$BOOST"
}
